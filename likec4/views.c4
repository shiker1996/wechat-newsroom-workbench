views {
  view architecture {
    title "功能架构图"
    description "见字 WeChat Newsroom Workbench 整体功能架构"
    include *
    include -> user
    include -> sqlite
    include -> llmProvider
    include -> externalSources
    style user { color green; shape person }
    style frontend { color blue }
    style frontend.shell { color blue }
    style frontend.router { color blue }
    style frontend.core { color blue }
    style frontend.httpClient { color blue; size sm }
    style frontend.viewModules { color blue; opacity 80% }
    style httpLayer { color indigo }
    style httpLayer.server { color indigo }
    style httpLayer.routes { color indigo; opacity 80% }
    style platform { color primary }
    style platform.store { color primary }
    style platform.llm { color primary }
    style platform.agent { color primary; opacity 80% }
    style platform.persistence { color primary; opacity 80% }
    style platform.tools { color primary; opacity 60% }
    style features { color amber }
    style features.collection { color amber; size sm }
    style features.research { color amber; size sm }
    style features.articles { color amber; size sm }
    style features.socialCards { color amber; size sm }
    style features.batches { color amber; size sm }
    style features.contentPlanning { color amber; size sm }
    style shared { color secondary }
    style shared.rendering { color secondary; size sm }
    style shared.themes { color secondary; size sm }
    style sqlite { color indigo; shape storage }
    style plugins { color muted }
    style llmProvider { color red; opacity 70% }
    style externalSources { color amber; opacity 70% }
    autoLayout LeftRight
  }

  view platformDetail of platform {
    title "平台核心层详解"
    description "Store LLM Agent 持久化 工具系统内部结构"
    include *
    include -> platform
    include -> sqlite
    include -> llmProvider
    include -> features
    style platform { color primary }
    style platform.store { color primary }
    style platform.llm { color primary }
    style platform.agent { color primary; opacity 80% }
    style platform.persistence { color primary; opacity 80% }
    style platform.tools { color primary; opacity 60% }
    style features { color amber; opacity 40% }
    style sqlite { color indigo; shape storage }
    style llmProvider { color red; opacity 70% }
    autoLayout LeftRight
  }

  view featureDetail of features {
    title "业务特性层详解"
    description "六大领域功能模块及其依赖关系"
    include *
    include -> features
    include features -> platform
    include features -> shared
    include features -> externalSources
    style features { color amber }
    style features.collection { color amber }
    style features.research { color amber }
    style features.articles { color amber }
    style features.socialCards { color amber }
    style features.batches { color amber }
    style features.contentPlanning { color amber }
    style platform { color primary; opacity 40% }
    style shared { color secondary; opacity 40% }
    style externalSources { color amber; opacity 60% }
    autoLayout LeftRight
  }

  dynamic view mainWorkflow {
    variant sequence
    title "主流程 用户请求到响应"
    description "从编辑操作到系统响应的完整数据流"
    user -> frontend.shell "点击导航项"
    frontend.shell -> frontend.router "URL hash 变更"
    frontend.router -> frontend.viewModules "懒加载视图模块" { technology "dynamic import" }
    frontend.viewModules -> frontend.httpClient "调用 fetch"
    frontend.httpClient -> httpLayer.server "HTTP POST /api" { technology "CSRF 令牌" }
    httpLayer.server -> httpLayer.routes "按 pathname 分发"
    parallel {
      httpLayer.routes -[sync]-> platform.store "CRUD 操作"
      httpLayer.routes -[async]-> platform.llm.gateway "AI 请求"
    }
    platform.store -[data]-> platform.persistence.repos "委托数据查询"
    platform.persistence.repos -[data]-> sqlite "SQL 查询" { technology "SQLite WAL" }
    platform.store -[data]-> platform.persistence.queries "复杂读取"
    platform.llm.gateway -> platform.llm.contextManager "压缩上下文"
    platform.llm.gateway -[async]-> llmProvider "API 调用"
    platform.llm.gateway <- llmProvider "返回响应"
    httpLayer.routes -> httpLayer.server "组装 JSON/NDJSON"
    httpLayer.server <- frontend.httpClient "HTTP 响应"
    frontend.httpClient -> frontend.viewModules "解析数据"
    frontend.viewModules -> frontend.shell "渲染 DOM"
    frontend.shell -> user "显示结果"
    include frontend.core with { opacity 10% }
    include platform with { opacity 10% }
    style user { color green; shape person }
    style frontend { color blue; opacity 60% }
    style httpLayer { color indigo; opacity 60% }
    style platform { color primary; opacity 40% }
    style sqlite { color indigo; shape storage; opacity 60% }
    style llmProvider { color red; opacity 50% }
  }

  dynamic view batchPipeline {
    variant sequence
    title "批次自动化管线"
    description "从数据采集到稿件生成的完整自动化流程"
    features.batches -> features.collection "启动采集" { technology "定时/手动" }
    features.collection -[async]-> externalSources "抓取 RSS" { technology "HTTPS" }
    features.collection -[sync]-> platform.store "存储采集结果"
    features.batches -> features.research "触发研究"
    features.research -[async]-> platform.llm.gateway "AI 标签/聚类"
    features.research -[data]-> platform.persistence.database "热度排序"
    features.batches -> features.articles "触发撰稿"
    features.articles -> platform.agent.conversationAgent "编审室对话"
    features.articles -> shared.rendering "生成排版"
    features.articles -> shared.themes "应用主题"
    features.articles -[data]-> platform.persistence.repos "保存终稿"
    platform.persistence.repos -[data]-> sqlite "写入 Document"
    features.batches -> features.contentPlanning "写入日历"
    alt {
      when "需要社交卡片" {
        features.socialCards -[async]-> platform.llm.gateway "AI 设计卡片"
        features.socialCards -> shared.rendering "渲染社交卡片"
        features.socialCards -> shared.themes "应用社交主题"
      }
      else "仅文章" {}
    }
    style features.batches { color amber }
    style features.collection { color amber; opacity 70% }
    style features.research { color amber; opacity 70% }
    style features.articles { color amber; opacity 70% }
    style features.socialCards { color amber; opacity 70% }
    style platform.llm { color primary; size sm }
    style platform.agent { color primary; opacity 60% }
    style sqlite { color indigo; shape storage }
    style externalSources { color amber }
    style shared { color secondary; opacity 60% }
  }
}