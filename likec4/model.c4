model {
  // ============ Actors ============
  user = person "编辑 (Editor)" {
    description "微信公众号内容创作者，使用系统进行选题、写作、发布"
  }

  // ============ Frontend ============
  frontend = system "前端 SPA" {
    description "单页应用前端，所有视图内嵌于单个 index.html"

    shell = container "SPA Shell (index.html)" {
      #core
      description "19+ 视图区域、导航侧栏、模态框、Toast 通知"
    }
    router = container "main.js (路由器)" {
      #core
      description "Hash 路由分发、视图懒加载、批量切换、沉浸式聊天"
    }
    core = container "core/ (基础模块)" {
      #core
      description "state.js, http.js, dom.js, ui.js, stream-chat.js"
      state = component "state.js" { description "全局可变状态对象" }
      httpClient = component "http.js" { description "Fetch 封装 + CSRF 令牌管理" }
      ui = component "ui.js" { description "Toast、确认框、Tab 导航、加载态" }
    }
    viewModules = container "views/ (29 个视图模块)" {
      #feature
      description "按需懒加载的视图模块"
      dashboard = component "dashboard.js" { description "概览面板" }
      editorial = component "editorial.js" { description "编审室 (AI 对话)" }
    }
  }

  // ============ HTTP Layer ============
  httpLayer = system "HTTP 服务层" {
    #core
    description "Node.js 原生 HTTP 服务器 + 路由分发"
    server = container "server.mjs" {
      #core
      description "主入口：组装 Store、ModelGateway、JobManager，分发请求"
    }
    security = container "local-security.mjs" {
      description "CSRF 令牌、操作确认、请求边界校验"
    }
    routeHelpers = container "route-helpers.mjs" {
      description "respond(), createNdjsonSession(), writeUtf8()"
    }
    routes = container "routes/ (12 个路由模块)" {
      #feature
      description "按功能域划分的 API 路由"
    }
  }

  // ============ Platform Core ============
  platform = system "平台核心层" {
    #core
    description "基础设施与公共能力"

    store = container "core/Store" {
      #core
      description "数据访问门面：组合 23 个 Repository + 4 个 QueryService"
    }
    config = container "core/config.mjs" { description "配置加载" }
    workspacePaths = container "core/workspace-paths.mjs" { description "目录路径解析" }
    instanceLock = container "core/instance-lock.mjs" { description "单实例锁" }

    llm = container "LLM (ModelGateway)" {
      #core
      description "统一大模型调用接口"
      gateway = component "gateway.mjs" { description "complete(), streamComplete(), streamEvents()" }
      contextManager = component "context-manager.mjs" { description "上下文窗口预算与压缩" }
      skillRuntime = component "skill-runtime.mjs" { description "技能包加载与执行" }
    }

    agent = container "Agent 系统" {
      description "多步骤对话代理"
      conversationAgent = component "conversation-agent.mjs" { description "ReAct 循环" }
      toolExecutor = component "tool-executor.mjs" { description "工具调用执行" }
      toolCatalog = component "tool-catalog.mjs" { description "工具名称到能力映射" }
    }

    persistence = container "持久化层" {
      #core
      description "SQLite 数据库访问"
      database = component "database.mjs" { description "SQLite 连接管理 (WAL 模式)" }
      repos = component "23 Repositories" { description "每个领域实体一个 Repository" }
      queries = component "4 QueryServices" { description "复杂读取模型" }
    }

    tools = container "工具/能力系统" {
      description "插件注册、能力路由、包管理"
      registry = component "registry.mjs" { description "中央工具/能力注册表" }
      capabilityRuntime = component "capability-runtime.mjs" { description "能力执行引擎" }
      packageManager = component "package-manager.mjs" { description "插件生命周期管理" }
    }
  }

  // ============ Feature Layer (DDD) ============
  features = system "业务特性层 (DDD)" {
    #feature
    description "按领域划分的业务能力模块"

    collection = container "信息采集" { #feature description "RSS/Reddit/GitHub 爬虫" }
    research = container "热点研究" { #feature description "AI 标签、事件聚类、热度排序" }
    articles = container "稿件生产" { #feature description "文章起草、编审室、审校" }
    socialCards = container "社交卡片" { #feature description "小红书/微信卡片生成" }
    batches = container "批次管线" { #feature description "采集→打标→研究→撰稿自动化" }
    contentPlanning = container "内容规划" { #feature description "内容日历、微信审校、反馈闭环" }
  }

  // ============ Shared Domain ============
  shared = system "共享领域层" {
    rendering = container "渲染引擎" { description "35 个模块：Markdown/社交卡片/排版" }
    themes = container "主题系统" { description "22 个模块：文章/封面/社交主题编译器" }
  }

  // ============ Storage ============
  sqlite = storage "SQLite 数据库" {
    #core
    description "WAL 模式，存储所有业务数据"
  }

  // ============ Plugin System ============
  plugins = system "插件/技能系统" {
    description "三类插件：工具、技能、采集器"
    toolPlugins = container "工具插件 (18 个)" { description "URL 抓取、RSSHub、搜索等" }
    writingSkills = container "写作技能 (45 个)" { description "微信文章合成、标题生成、SEO" }
    collectorPlugins = container "采集器插件" { description "动态注册的数据采集器" }
  }

  // ============ External ============
  llmProvider = system "LLM 提供商" { description "OpenAI 兼容 API" }
  externalSources = system "外部数据源" { description "RSS/Reddit/GitHub/网页" }

  // ======================================================================
  // Relationships
  // ======================================================================

  // User -> Frontend
  user -> frontend.shell "浏览与操作" { technology "浏览器" }
  user -> frontend.viewModules "触发操作"

  // Frontend internal
  frontend.shell -> frontend.router "导航事件"
  frontend.router -> frontend.viewModules "懒加载视图" { technology "dynamic import()" }
  frontend.viewModules -> frontend.core.httpClient "发起 HTTP 请求"
  frontend.viewModules -> frontend.core.state "读写状态"
  frontend.core.httpClient -> frontend.core.state "更新状态"

  // Frontend -> HTTP Layer
  frontend.core.httpClient -> httpLayer.server "HTTP 请求 /api/*" { technology "HTTP + CSRF" }

  // HTTP Layer internal
  httpLayer.server -> httpLayer.routes "按 pathname 分发"
  httpLayer.server -> httpLayer.security "安全检查"

  // HTTP Layer -> Platform
  httpLayer.routes -[sync]-> platform.store "CRUD 操作"
  httpLayer.routes -[async]-> platform.llm.gateway "AI 调用"
  httpLayer.routes -[async]-> platform.persistence.database "直接查询"

  // Store -> Persistence
  platform.store -[data]-> platform.persistence.repos "委托数据访问"
  platform.store -[data]-> platform.persistence.queries "委托复杂查询"

  // Platform internals
  platform.llm.gateway -> platform.llm.contextManager "压缩上下文"
  platform.llm.gateway -> platform.llm.skillRuntime "执行技能"
  platform.llm.gateway -[async]-> llmProvider "API 调用" { technology "HTTPS/OpenAI" }

  platform.agent.conversationAgent -> platform.llm.gateway "获取 AI 回复"
  platform.agent.conversationAgent -> platform.agent.toolExecutor "执行工具"
  platform.agent.toolExecutor -> platform.tools.registry "查找工具能力"

  // Features -> Platform
  features.collection -[sync]-> platform.store "读写数据"
  features.collection -[async]-> externalSources "抓取内容" { technology "HTTPS/RSS" }
  features.research -[data]-> platform.persistence.database "分析查询"
  features.research -[async]-> platform.llm.gateway "AI 标注"
  features.articles -[async]-> platform.llm.gateway "AI 协助撰稿"
  features.articles -> platform.agent.conversationAgent "编审对话"
  features.articles -[data]-> platform.persistence.queries "文档查询"
  features.batches -> features.collection "触发采集"
  features.batches -> features.research "触发研究"
  features.batches -> features.articles "触发撰稿"
  features.socialCards -[async]-> platform.llm.gateway "AI 卡片设计"
  features.socialCards -> shared.rendering "卡片渲染"
  features.socialCards -> shared.themes "主题编译"

  // Shared -> Platform
  shared.rendering -> platform.store "读取主题配置"
  shared.themes -> platform.store "读写主题数据"

  // Platform -> Storage
  platform.persistence.database -[data]-> sqlite "读/写" { technology "SQLite (WAL)" }

  // Plugin system integration
  plugins.toolPlugins -> platform.tools.registry "注册工具"
  plugins.writingSkills -> platform.llm.skillRuntime "注册技能"
  platform.tools.packageManager -> plugins "管理生命周期"
}