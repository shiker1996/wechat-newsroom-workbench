{
    "name": "wechat-newsroom-workbench",
    "version": "0.6.8",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "本地优先的公众号热点、成稿与排版工作台",
    "scripts": {
        "start": "node --disable-warning=ExperimentalWarning server.mjs",
        "setup": "node scripts/runtime/setup.mjs",
        "dev": "node --disable-warning=ExperimentalWarning --watch --watch-path=server.mjs --watch-path=server server.mjs",
        "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.mjs",
        "test:fast": "node scripts/build/test-fast.mjs",
        "event-resolution:backfill": "node scripts/migration/backfill-event-resolution.mjs",
        "topic-score:replay": "node scripts/migration/replay-topic-score.mjs",
        "build": "node scripts/build/build.mjs",
        "build:styles": "node scripts/build/build-styles.mjs",
        "check:legacy-config-guidance": "node scripts/quality/check-legacy-configuration-guidance.mjs",
        "postinstall": "node scripts/runtime/install-skill-deps.mjs",
        "build:watch": "node --watch scripts/build/build.mjs",
        "skill:validate": "node scripts/quality/validate-skill-package.mjs",
        "plugin:validate": "node scripts/quality/validate-tool-plugin.mjs",
        "plugin:audit-boundaries": "node scripts/quality/audit-plugin-boundaries.mjs",
        "plugin:verify-distribution": "node scripts/quality/verify-plugin-distribution.mjs",
        "plugin:baseline-boundaries": "node scripts/quality/snapshot-plugin-boundary-baseline.mjs",
        "config:baseline": "node scripts/quality/snapshot-legacy-configuration.mjs",
        "config:migrate": "node --disable-warning=ExperimentalWarning scripts/migration/migrate-legacy-configuration.mjs",
        "capability:baseline": "node scripts/quality/snapshot-tool-call-baseline.mjs",
        "capability:gates": "node --disable-warning=ExperimentalWarning scripts/quality/check-consumer-capability-gates.mjs",
        "capability:consumer-baseline": "node --disable-warning=ExperimentalWarning scripts/quality/snapshot-consumer-capability-baseline.mjs",
        "capability:migrate-routes": "node scripts/migration/migrate-capability-routes.mjs",
        "release": "node scripts/release/release.mjs"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1109.0",
        "markdown-it": "^14.1.0"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0"
    }
}
