{
    "name": "wechat-newsroom-workbench",
    "version": "0.5.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "本地优先的公众号热点、成稿与排版工作台",
    "scripts": {
        "start": "node --disable-warning=ExperimentalWarning server.mjs",
        "setup": "node scripts/setup.mjs",
        "dev": "node --disable-warning=ExperimentalWarning --watch --watch-path=server.mjs --watch-path=lib server.mjs",
        "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.mjs",
        "test:fast": "node scripts/test-fast.mjs",
        "build": "node scripts/build.mjs",
        "check:legacy-config-guidance": "node scripts/check-legacy-configuration-guidance.mjs",
        "postinstall": "node scripts/install-skill-deps.mjs",
        "build:watch": "node --watch scripts/build.mjs",
        "skill:validate": "node scripts/validate-skill-package.mjs",
        "plugin:validate": "node scripts/validate-tool-plugin.mjs",
        "plugin:audit-boundaries": "node scripts/audit-plugin-boundaries.mjs",
        "plugin:verify-distribution": "node scripts/verify-plugin-distribution.mjs",
        "plugin:baseline-boundaries": "node scripts/snapshot-plugin-boundary-baseline.mjs",
        "config:baseline": "node scripts/snapshot-legacy-configuration.mjs",
        "config:migrate": "node --disable-warning=ExperimentalWarning scripts/migrate-legacy-configuration.mjs",
        "capability:baseline": "node scripts/snapshot-tool-call-baseline.mjs",
        "capability:gates": "node --disable-warning=ExperimentalWarning scripts/check-consumer-capability-gates.mjs",
        "capability:consumer-baseline": "node --disable-warning=ExperimentalWarning scripts/snapshot-consumer-capability-baseline.mjs",
        "capability:migrate-routes": "node scripts/migrate-capability-routes.mjs",
        "release": "node scripts/release.mjs"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1109.0",
        "markdown-it": "^14.1.0"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0"
    }
}
