{
    "name": "wechat-newsroom-workbench",
    "version": "0.4.1",
    "private": true,
    "license": "MIT",
    "type": "module",
    "description": "本地优先的公众号热点、成稿与排版工作台",
    "scripts": {
        "start": "node --disable-warning=ExperimentalWarning server.mjs",
        "setup": "node scripts/setup.mjs",
        "dev": "node --disable-warning=ExperimentalWarning --watch --watch-path=server.mjs --watch-path=lib server.mjs",
        "test": "node --disable-warning=ExperimentalWarning --test test/**/*.test.mjs",
        "test:fast": "node scripts/test-fast.mjs",
        "build": "node scripts/build.mjs",
        "postinstall": "node scripts/install-skill-deps.mjs",
        "build:watch": "node --watch scripts/build.mjs",
        "skill:validate": "node scripts/validate-skill-package.mjs",
        "plugin:validate": "node scripts/validate-tool-plugin.mjs",
        "release": "node scripts/release.mjs"
    },
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "markdown-it": "^14.1.0"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0"
    }
}
