# 复制为 .env，只填写实际使用的服务商。不要提交真实密钥。
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=

# 可选：临时使用另一个端口启动工作台，便于并行验收或避开端口占用。
WORKBENCH_PORT=

# 可选。通常会自动发现 py/python 或 Codex 内置 Python；无法发现时填写 python.exe 绝对路径。
WRITE_ASSISTANT_PYTHON=

# 原文抓取：auto=Firecrawl MCP 优先、失败回退 Python；firecrawl=只用 MCP；python=只用本地脚本。
SOURCE_FETCH_PROVIDER=auto
FIRECRAWL_MCP_URL=https://mcp.firecrawl.dev/v2/mcp
# 可选；无 Key 可使用 Firecrawl 限流免费档的 scrape。配置后额度更高。
FIRECRAWL_API_KEY=

# 可选：配图工作台点击“上传 CDN”时使用。未点击不会产生外部写入。
UPYUN_BUCKET=
UPYUN_OPERATOR=
UPYUN_PASSWORD=
UPYUN_DOMAIN=img.shiker.tech
UPYUN_PREFIX=weedit
