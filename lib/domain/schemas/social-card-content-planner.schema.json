{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social_card_content_planner",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "page", "groups"],
            "properties": {
              "op": { "const": "split_page" },
              "page": { "type": "integer", "minimum": 1 },
              "groups": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["blocks"],
                  "properties": {
                    "blocks": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["block", "items"],
                        "properties": {
                          "block": { "type": "integer", "minimum": 0 },
                          "items": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "from_page", "to_page", "block"],
            "properties": {
              "op": { "const": "move_block" },
              "from_page": { "type": "integer", "minimum": 1 },
              "to_page": { "type": "integer", "minimum": 1 },
              "block": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "pages"],
            "properties": {
              "op": { "const": "merge_pages" },
              "pages": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "page", "component_id", "source_refs"],
            "properties": {
              "op": { "const": "add_component" },
              "page": { "type": "integer", "minimum": 1 },
              "component_id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "render_type": { "enum": ["text", "list", "steps", "timeline", "scenes", "stats", "compare", "note", "code"] },
              "fact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 9 },
              "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "block": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["text", "list", "steps", "timeline", "scenes", "stats", "compare", "note", "code"] },
                  "fact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 9 },
                  "title": { "type": "string" },
                  "content": { "type": "string" },
                  "items": { "type": "array" },
                  "rows": { "type": "array" },
                  "headers": { "type": "array" },
                  "source_refs": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        ]
      }
    }
  }
}
