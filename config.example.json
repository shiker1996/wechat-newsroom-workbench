{
  "port": 4317,
  "workspaceRoot": ".",
  "contentRoots": [],
  "reddit": {
    "cdpUrl": "http://localhost:9333",
    "navigationTimeoutMs": 30000
  },
  "rsshub": {
    "baseUrl": "http://127.0.0.1:1200",
    "rootDir": "RSSHub",
    "startScript": "scripts/runtime/rsshub-start.ps1",
    "stopScript": "scripts/runtime/rsshub-stop.ps1",
    "pidFile": "data/rsshub.pid",
    "startupTimeoutMs": 180000,
    "keepAlive": true,
    "maxAgeHours": 168,
    "allowUndated": true,
    "concurrency": 5
  },
  "githubDiscovery": {
    "enabled": true,
    "createdWithinDays": 7,
    "minStars": 1000,
    "limit": 30,
    "cacheTtlMs": 1800000,
    "aiQueries": {
      "enabled": true,
      "refreshDays": 7,
      "maxQueries": 6,
      "perQueryLimit": 15,
      "relevanceFilter": true,
      "minInterestScore": 6
    }
  },
  "llm": {
    "requestTimeoutMs": 300000,
    "safetyReserveTokens": 2048,
    "recentMessageCount": 8
  },
  "tavily": { "enabled": false, "apiKeyEnv": "TAVILY_API_KEY", "maxResults": 5 },
  "documentSearch": { "roots": [] },
  "sourceFetch": {
    "upgradeThreshold": 55,
    "rssContentMinChars": 800,
    "rssFallbackMinChars": 200,
    "githubMinChars": 200
  },
  "aiJobs": { "maxConcurrent": 2 },
  "conversationAgent": {
    "maxModelSteps": 3,
    "maxToolCalls": 5,
    "maxParallelToolCalls": 3,
    "maxToolResultChars": 8000,
    "maxTotalToolResultChars": 24000,
    "timeoutMs": 90000
  },
  "articleLength": {
    "minVisibleChars": 1300,
    "maxVisibleChars": 2000,
    "pipelines": { "article": {}, "daily": {}, "tutorial": {} }
  }
}
