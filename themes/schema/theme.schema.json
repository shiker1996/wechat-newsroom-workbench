{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://write-assistant.local/schemas/theme.schema.json",
  "title": "Write Assistant Theme Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "label", "version", "description", "targets", "status", "source", "basedOn", "tags", "tokens"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "label": { "type": "string", "minLength": 1, "maxLength": 30 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 160 },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["article", "social", "cover"] } },
    "status": { "enum": ["draft", "published", "disabled", "archived"] },
    "source": { "enum": ["builtin", "user"] },
    "basedOn": { "type": ["null", "object"] },
    "tags": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography", "spacing", "shape"],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "surface", "text", "muted", "accent", "accentSecondary", "line", "inverseText", "codeBackground"],
          "properties": {
            "background": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" }, "page": { "$ref": "#/$defs/color" },
            "text": { "$ref": "#/$defs/color" }, "muted": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" }, "accentSecondary": { "$ref": "#/$defs/color" },
            "line": { "$ref": "#/$defs/color" }, "inverseText": { "$ref": "#/$defs/color" },
            "codeBackground": { "$ref": "#/$defs/color" }
          }
        },
        "typography": {
          "type": "object", "additionalProperties": false,
          "required": ["family", "headingFamily", "bodyPx", "h1Px", "h2Px", "captionPx", "lineHeight", "letterSpacingEm"],
          "properties": {
            "family": { "enum": ["sans", "serif", "mono"] }, "headingFamily": { "enum": ["sans", "serif", "mono"] },
            "bodyPx": { "type": "number", "minimum": 9, "maximum": 18, "multipleOf": 1 }, "h1Px": { "type": "number", "minimum": 22, "maximum": 44, "multipleOf": 1 },
            "h2Px": { "type": "number", "minimum": 11, "maximum": 28, "multipleOf": 1 }, "captionPx": { "type": "number", "minimum": 8, "maximum": 15, "multipleOf": 1 },
            "codePx": { "type": "number", "minimum": 8, "maximum": 15, "multipleOf": 1 },
            "lineHeight": { "type": "number", "minimum": 1.2, "maximum": 2.1, "multipleOf": 0.05 }, "letterSpacingEm": { "type": "number", "minimum": -0.08, "maximum": 0.2, "multipleOf": 0.005 }
          }
        },
        "spacing": {
          "type": "object", "additionalProperties": false,
          "required": ["articlePaddingPx", "sectionPx", "paragraphPx", "cardGapPx"],
          "properties": {
            "articlePaddingPx": { "type": "number", "minimum": 0, "maximum": 40, "multipleOf": 1 }, "sectionPx": { "type": "number", "minimum": 12, "maximum": 48, "multipleOf": 1 },
            "paragraphPx": { "type": "number", "minimum": 6, "maximum": 28, "multipleOf": 1 }, "cardGapPx": { "type": "number", "minimum": 0, "maximum": 28, "multipleOf": 1 }
          }
        },
        "shape": {
          "type": "object", "additionalProperties": false,
          "required": ["radiusPx", "borderWidthPx", "shadow"],
          "properties": {
            "radiusPx": { "type": "number", "minimum": 0, "maximum": 32, "multipleOf": 1 }, "borderWidthPx": { "type": "number", "minimum": 0, "maximum": 8, "multipleOf": 1 },
            "shadow": { "enum": ["none", "soft", "hard", "glow"] }
          }
        }
      }
    },
    "article": {
      "type": "object", "additionalProperties": false, "required": ["recipes", "behavior"],
      "properties": {
        "recipes": { "type": "object", "additionalProperties": { "type": "string" } },
        "components": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "title": { "type": "object", "additionalProperties": false, "required": ["fontFamily", "sizeScale", "colorRole"], "properties": { "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] }, "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } } },
            "lead": { "type": "object", "additionalProperties": false, "required": ["sizeScale", "colorRole"], "properties": { "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } } },
            "quote": { "type": "object", "additionalProperties": false, "required": ["textColorRole", "surfaceRole", "borderColorRole"], "properties": { "textColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "surfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] }, "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] } } },
            "list": { "type": "object", "additionalProperties": false, "required": ["textColorRole", "markerColorRole"], "properties": { "textColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "markerColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } } },
            "table": { "type": "object", "additionalProperties": false, "required": ["headerTextColorRole", "headerSurfaceRole", "borderColorRole"], "properties": { "headerTextColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "headerSurfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] }, "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] } } },
            "code": { "type": "object", "additionalProperties": false, "required": ["textColorRole", "surfaceRole"], "properties": { "textColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "surfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] } } },
            "imageCaption": { "type": "object", "additionalProperties": false, "required": ["sizeScale", "colorRole"], "properties": { "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } } }
          }
        },
        "behavior": {
          "type": "object", "additionalProperties": false, "required": ["justify", "highlightStrong", "numberSections"],
          "properties": { "justify": { "type": "boolean" }, "highlightStrong": { "enum": ["accent", "ink"] }, "numberSections": { "type": "boolean" } }
        }
      }
    },
    "social": {
      "type": "object", "additionalProperties": false, "required": ["recipes", "effects"],
      "properties": {
        "recipes": { "type": "object", "additionalProperties": { "type": "string" } },
        "templatePack": {
          "type": "object", "additionalProperties": false, "required": ["id", "version"],
          "properties": {
            "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 },
            "label": { "type": "string", "maxLength": 80 }, "renderer": { "type": "string", "maxLength": 80 },
            "proposalId": { "type": "string", "maxLength": 80 }, "source": { "enum": ["proposal", "builtin", "inherited"] },
            "fallbackTemplate": { "type": ["string", "null"] }, "css": { "type": "string", "maxLength": 20000 },
            "surface": { "type": "object", "additionalProperties": false, "properties": { "density": { "enum": ["compact", "standard", "airy"] }, "decoration": { "enum": ["none", "grid-line", "orbit", "stamp", "index-line", "paper-rule", "accent-edge"] }, "headingTreatment": { "enum": ["plain", "accent-bar", "highlight-block", "underline", "numbered"] } } },
            "roleTemplates": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 64 } },
            "roles": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["template", "supportedBlocks", "maxBlocks", "maxItems"], "properties": { "template": { "type": "string", "maxLength": 64 }, "supportedBlocks": { "type": "array", "maxItems": 10, "items": { "type": "string" } }, "maxBlocks": { "type": "integer", "minimum": 1, "maximum": 6 }, "maxItems": { "type": "integer", "minimum": 1, "maximum": 12 }, "notes": { "type": "string", "maxLength": 160 } } } }
          }
        },
        "templateMatch": {
          "type": "object", "additionalProperties": false, "required": ["schemaVersion", "packId", "source", "confidence", "reasonCode", "score", "runnerUpScore", "margin", "reason", "signals"],
          "properties": {
            "schemaVersion": { "const": 1 }, "packId": { "type": "string" },
            "source": { "enum": ["program-recommended", "user-selected", "inherited", "compatibility"] },
            "confidence": { "enum": ["high", "medium", "low"] },
            "reasonCode": { "enum": ["CLEAR_DIRECTION", "NO_DIRECTION_SIGNAL", "WEAK_DIRECTION_SIGNAL", "AMBIGUOUS_DIRECTION_SIGNAL"] },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "runnerUpScore": { "type": "integer", "minimum": 0, "maximum": 100 },
            "margin": { "type": "integer", "minimum": -100, "maximum": 100 },
            "reason": { "type": "string", "minLength": 1, "maxLength": 240 },
            "signals": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40 } }
          }
        },
        "components": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "coverTitle": {
              "type": "object", "additionalProperties": false,
              "required": ["fontFamily", "fontWeight", "sizeScale", "colorRole", "borderColorRole"],
              "properties": {
                "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] },
                "fontWeight": { "enum": [500, 600, 700, 800, 900] },
                "sizeScale": { "enum": ["compact", "standard", "display"] },
                "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] },
                "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] }
              }
            },
            "eyebrow": {
              "type": "object", "additionalProperties": false,
              "required": ["fontFamily", "fontWeight", "colorRole"],
              "properties": {
                "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] },
                "fontWeight": { "enum": [500, 600, 700, 800, 900] },
                "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }
              }
            },
            "lead": {
              "type": "object", "additionalProperties": false,
              "required": ["sizeScale", "colorRole"],
              "properties": {
                "sizeScale": { "enum": ["compact", "standard", "display"] },
                "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }
              }
            },
            "statValue": {
              "type": "object", "additionalProperties": false, "required": ["fontFamily", "fontWeight", "sizeScale", "colorRole"],
              "properties": { "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] }, "fontWeight": { "enum": [500, 600, 700, 800, 900] }, "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } }
            },
            "statLabel": {
              "type": "object", "additionalProperties": false, "required": ["sizeScale", "colorRole"],
              "properties": { "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } }
            },
            "step": {
              "type": "object", "additionalProperties": false, "required": ["titleColorRole", "bodyColorRole", "markerSurfaceRole"],
              "properties": { "titleColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "bodyColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "markerSurfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] } }
            },
            "compareTable": {
              "type": "object", "additionalProperties": false, "required": ["headerTextColorRole", "headerSurfaceRole", "bodyTextColorRole", "borderColorRole"],
              "properties": { "headerTextColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "headerSurfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] }, "bodyTextColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] } }
            },
            "list": {
              "type": "object", "additionalProperties": false, "required": ["textColorRole", "surfaceRole", "borderColorRole", "borderWeight"],
              "properties": { "textColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "surfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] }, "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] }, "borderWeight": { "enum": ["inherit", "none", "thin", "medium", "heavy"] } }
            },
            "note": {
              "type": "object", "additionalProperties": false, "required": ["textColorRole", "surfaceRole", "borderColorRole", "borderWeight"],
              "properties": { "textColorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] }, "surfaceRole": { "enum": ["inherit", "transparent", "surface", "page", "accent", "accentSecondary", "codeBackground"] }, "borderColorRole": { "enum": ["line", "text", "accent", "accentSecondary"] }, "borderWeight": { "enum": ["inherit", "none", "thin", "medium", "heavy"] } }
            },
            "contentTitle": {
              "type": "object", "additionalProperties": false, "required": ["fontFamily", "sizeScale", "colorRole"],
              "properties": { "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] }, "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } }
            },
            "endingTitle": {
              "type": "object", "additionalProperties": false, "required": ["fontFamily", "sizeScale", "colorRole"],
              "properties": { "fontFamily": { "enum": ["inherit", "sans", "serif", "mono"] }, "sizeScale": { "enum": ["compact", "standard", "display"] }, "colorRole": { "enum": ["text", "muted", "accent", "accentSecondary", "inverseText"] } }
            }
          }
        },
        "effects": {
          "type": "object", "additionalProperties": false, "required": ["texture", "decorationOpacity", "contentTiltDeg"],
          "properties": {
            "texture": { "enum": ["none", "grid", "scanlines", "paper-grain"] },
            "decorationOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "contentTiltDeg": { "type": "number", "minimum": -2, "maximum": 2 }
          }
        }
      }
    }
  },
  "$defs": { "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
}
