{
  "id": "firecrawl-search",
  "name": "Firecrawl 搜索",
  "version": "1.0.0",
  "credentialProfile": "tool-url-fetch",
  "capabilities": ["cap_content_research_search"],
  "entry": "./adapter.mjs",
  "riskLevel": "network-read",
  "inputSchema": {
    "type": "object",
    "required": ["query"],
    "additionalProperties": false,
    "properties": {
      "query": {"type": "string"},
      "maxResults": {"type": "integer", "minimum": 1, "maximum": 5},
      "sourceType": {"type": "string", "enum": ["web", "news"]}
    }
  },
  "outputSchema": {
    "type": "object",
    "required": ["results"],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["title", "url", "snippet"],
          "properties": {
            "title": {"type": "string"},
            "url": {"type": "string"},
            "snippet": {"type": "string"},
            "source": {"type": "string"},
            "publishedAt": {"type": "string"}
          }
        }
      }
    }
  },
  "configuration": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "endpoint": {"type": "string", "format": "url", "default": "https://api.firecrawl.dev/v2/search"},
      "apiKey": {"type": "string", "secret": true, "format": "password"}
    },
    "required": ["apiKey"]
  },
  "healthCheck": true,
  "enabledByDefault": true,
  "schemaVersion": 1,
  "kind": "tool",
  "runtime": {}
}
