{
  "id": "tavily-search",
  "name": "Tavily 搜索",
  "version": "1.0.0",
  "capabilities": [
    "cap_content_web_search",
    "cap_content_news_search"
  ],
  "entry": "./adapter.mjs",
  "riskLevel": "network-read",
  "inputSchema": {
    "type": "object",
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "properties": {
      "query": {
        "type": "string"
      },
      "maxResults": {
        "type": "integer"
      },
      "timeRange": {
        "type": "string",
        "enum": [
          "day",
          "week",
          "month",
          "year"
        ]
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "required": [
      "results"
    ],
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "title",
            "url",
            "snippet"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "publishedAt": {
              "type": "string"
            }
          }
        }
      },
      "answer": {
        "type": "string"
      }
    }
  },
  "configuration": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "title": "Tavily API Key",
        "secret": true,
        "format": "password"
      },
      "enabled": {
        "type": "boolean",
        "title": "启用搜索",
        "default": true
      },
      "maxResults": {
        "type": "integer",
        "title": "默认结果数",
        "minimum": 1,
        "maximum": 10,
        "default": 5
      }
    },
    "required": [
      "apiKey"
    ]
  },
  "healthCheck": true,
  "enabledByDefault": true,
  "schemaVersion": 1,
  "kind": "tool",
  "runtime": {}
}
