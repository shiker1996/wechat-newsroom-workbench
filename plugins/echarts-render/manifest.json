{
  "id": "echarts-render",
  "name": "ECharts 图片渲染",
  "version": "1.0.1",
  "capabilities": [
    "diagram.echarts.render"
  ],
  "entry": "./adapter.mjs",
  "riskLevel": "local-write",
  "pathInputs": [
    "inputPath",
    "outputPath",
    "imageDir",
    "tokensPath"
  ],
  "inputSchema": {
    "type": "object",
    "required": [
      "inputPath",
      "outputPath",
      "imageDir"
    ],
    "properties": {
      "inputPath": {
        "type": "string"
      },
      "outputPath": {
        "type": "string"
      },
      "imageDir": {
        "type": "string"
      },
      "tokensPath": {
        "type": "string"
      }
    }
  },
  "outputSchema": {
    "type": "object"
  },
  "healthCheck": true,
  "enabledByDefault": true,
  "schemaVersion": 1,
  "kind": "tool",
  "runtime": {}
}
