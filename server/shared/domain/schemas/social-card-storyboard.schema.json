{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social_card_storyboard",
  "type": "object",
  "required": ["target_reader", "recommended_pages", "card_plan"],
  "properties": {
    "target_reader": { "type": "string" },
    "pain_point": { "type": "string" },
    "tool_positioning": { "type": "string" },
    "must_highlight": { "type": ["string", "array"] },
    "must_disclose": { "type": ["string", "array"] },
    "getting_started": { "type": ["string", "array"] },
    "forbidden_claims": { "type": ["string", "array"] },
    "recommended_pages": { "type": "integer", "minimum": 4, "maximum": 10 },
    "card_plan": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["kind", "title", "goal", "evidence", "content_blocks"],
        "properties": {
          "kind": { "type": "string" },
          "role": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "goal": { "type": "string" },
          "evidence": { "type": "array" },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "source_refs": { "type": "array", "items": { "type": "string" } },
                "visual": {
                  "type": "object",
                  "properties": {
                    "emphasis": { "type": "string", "enum": ["normal", "strong", "hero"] },
                    "tone": { "type": "string", "enum": ["default", "accent", "danger", "success", "warning", "muted"] },
                    "icon": { "type": "string", "enum": ["none", "metric", "ai", "price", "warning", "source", "user", "timeline", "rocket"] },
                    "badge": { "type": "string", "maxLength": 12 }
                  },
                  "additionalProperties": false
                },
                "content_runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["text"],
                    "properties": {
                      "text": { "type": "string" },
                      "role": { "type": "string", "enum": ["normal", "metric", "label", "warning", "source"] },
                      "tone": { "type": "string", "enum": ["default", "accent", "danger", "success", "warning", "muted"] },
                      "emphasis": { "type": "string", "enum": ["normal", "strong"] }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "composition": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
