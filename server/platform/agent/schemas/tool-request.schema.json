{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jianzi.local/schemas/conversation-agent/tool-request.v1.json",
  "title": "Conversation Agent ToolRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "capability", "arguments"],
  "properties": {
    "requestId": { "type": "string", "pattern": "^tr_[A-Za-z0-9_-]{1,61}$" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 120 },
    "arguments": { "type": "object" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
